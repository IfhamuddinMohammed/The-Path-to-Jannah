{
  "name": "RomanUrduSurah",
  "type": "object",
  "properties": {
    "surah_number": {
      "type": "number",
      "description": "The surah number (1-114)"
    },
    "ayah_number": {
      "type": "number",
      "description": "The ayah number within the surah"
    },
    "roman_urdu": {
      "type": "string",
      "description": "Roman Urdu (Latin-script) text for this single verse"
    }
  },
  "required": [
    "surah_number",
    "ayah_number",
    "roman_urdu"
  ]
}