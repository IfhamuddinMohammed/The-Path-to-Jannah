{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "default": "Anonymous",
      "description": "Display name of the poster as stored — the same value is shown to every viewer except the original poster, who instead sees 'You' client-side (see isMine() in src/lib/ownership.js). Never the literal string 'You'."
    },
    "author_role": {
      "type": "string",
      "default": "Community Member",
      "description": "Poster's role/badge label (e.g. Community Member, Verified Helper)"
    },
    "section": {
      "type": "string",
      "enum": ["discussions", "new_muslims"],
      "description": "Which Community tab this post belongs to"
    },
    "category": {
      "type": "string",
      "enum": ["Reflection", "Verse Insight", "General Question"],
      "description": "Post category"
    },
    "content": {
      "type": "string",
      "maxLength": 2000,
      "description": "Post body text"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    }
  },
  "required": ["section", "category", "content"]
}
