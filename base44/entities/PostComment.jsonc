{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "The CommunityPost id this comment belongs to"
    },
    "author": {
      "type": "string",
      "default": "Anonymous",
      "description": "Comment author display name as stored — every viewer except the original commenter sees this value; the commenter instead sees 'You' client-side (see isMine() in src/lib/ownership.js). Never the literal string 'You'."
    },
    "content": {
      "type": "string",
      "maxLength": 500,
      "description": "Comment text"
    }
  },
  "required": ["post_id", "content"]
}
