{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "The CommunityPost id this comment belongs to"
    },
    "author": {
      "type": "string",
      "default": "You",
      "description": "Comment author display name"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    }
  },
  "required": ["post_id", "content"]
}
