{
  "name": "SeerahLocation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the location"
    },
    "arabic_name": {
      "type": "string",
      "description": "Name in Arabic"
    },
    "significance": {
      "type": "string",
      "description": "Why this location is significant in the Seerah"
    },
    "significance_roman_urdu": {
      "type": "string",
      "description": "Why this location is significant in the Seerah, in Roman Urdu (Latin-script Urdu)"
    },
    "events_count": {
      "type": "number",
      "description": "Number of notable events associated with this location"
    }
  },
  "required": ["name", "arabic_name", "significance"]
}
